<Window x:Class="BarcodeStudio.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
		Title="Barcode Studio | إدارة المنتجات وطباعة الباركود"
		Width="1240"
		Height="830"
		MinWidth="980"
		MinHeight="680"
		WindowStartupLocation="CenterScreen"
		Background="#F1F5F9"
		FlowDirection="RightToLeft">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="72" />
			<RowDefinition Height="*" />
			<RowDefinition Height="33" />
		</Grid.RowDefinitions>
		<Border Background="#0F172A"
				Grid.Row="0">
			<DockPanel Margin="20,10">
				<StackPanel DockPanel.Dock="Right"
							Orientation="Horizontal">
					<TextBlock Text="▥"
							   FontSize="31"
							   Foreground="#60A5FA"
							   Margin="0,0,15,0" />
					<StackPanel>
						<TextBlock Text="BARCODE STUDIO"
								   Foreground="White"
								   FontWeight="Bold"
								   FontSize="21" />
						<TextBlock Text="إدارة المنتجات وطباعة الملصقات الحرارية"
								   Foreground="#CBD5E1"
								   FontSize="12" />
					</StackPanel>
				</StackPanel>
				<TextBlock HorizontalAlignment="Left"
						   Text="إنتاج HT_SOLUTIONS  |  01157235269"
						   Foreground="#CBD5E1"
						   VerticalAlignment="Center" />
			</DockPanel>
		</Border>
		<TabControl Grid.Row="1"
					Margin="15"
					FontSize="14"
					Background="White">
			<TabItem Header="🗃 إدارة المنتجات">
				<Grid Margin="15">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="330" />
					</Grid.ColumnDefinitions>
					<DockPanel Grid.Column="0"
							   Margin="0,0,12,0">
						<StackPanel DockPanel.Dock="Top"
									Orientation="Horizontal"
									Margin="0,0,0,10">
							<TextBlock Text="المنتجات المسجلة"
									   FontWeight="Bold"
									   FontSize="19" />
							<Button Content="تحديث القائمة"
									Click="Refresh_Click"
									Margin="15,0" />
						</StackPanel>
						<DataGrid x:Name="ProductsGrid"
								  AutoGenerateColumns="False"
								  SelectionMode="Single"
								  IsReadOnly="True"
								  FontSize="20"
								  SelectionChanged="ProductsGrid_SelectionChanged"
								  AlternatingRowBackground="#F8FAFC">
							<DataGrid.Columns>
								<DataGridTextColumn Header="الكود"
													Binding="{Binding Code}"
													Width="200" />
								<DataGridTextColumn Header="اسم المنتج"
													Binding="{Binding Name}"
													Width="*" />
								<DataGridTextColumn Header="السعر"
													Binding="{Binding Price}"
													Width="85" />
								<DataGridTextColumn Header="الصلاحية (يوم)"
													Binding="{Binding ShelfLifeDays}"
													Width="110" />
							</DataGrid.Columns>
						</DataGrid>
					</DockPanel>
					<Border Grid.Column="1"
							Background="#F8FAFC"
							CornerRadius="10"
							Padding="15">
						<StackPanel>
							<TextBlock Text="بيانات المنتج"
									   FontSize="19"
									   FontWeight="Bold"
									   Margin="0,0,0,12" />
							<TextBlock Text="كود / رقم الباركود" />
							<TextBox x:Name="CodeBox" />
							<TextBlock Text="اسم المنتج"
									   Margin="0,10,0,0" />
							<TextBox x:Name="NameBox" />
							<TextBlock Text="السعر (اختياري)"
									   Margin="0,10,0,0" />
							<TextBox x:Name="PriceBox"
									 Text="0" />
							<TextBlock Text="عدد أيام الصلاحية الافتراضي"
									   Margin="0,10,0,0" />
							<TextBox x:Name="ShelfBox"
									 Text="7" />
							<Button Content="حفظ المنتج"
									Click="SaveProduct_Click"
									Background="#2563EB"
									Foreground="White"
									Margin="3,20,3,5" />
							<Button Content="منتج جديد / إلغاء التحديد"
									Click="NewProduct_Click" />
							<Button Content="حذف المنتج المحدد"
									Click="DeleteProduct_Click"
									Foreground="#B91C1C"
									Margin="3,20,3,3" />
							<TextBlock Text="ملاحظة: يتم إنشاء الباركود من الكود المسجل للمنتج."
									   TextWrapping="Wrap"
									   Foreground="#64748B"
									   Margin="3,20,3,0" />
						</StackPanel>
					</Border>
				</Grid>
			</TabItem>
			<TabItem Header="🖨 تجهيز وطباعة">
				<Grid Margin="15">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="360" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<ScrollViewer Grid.Column="0"
								  VerticalScrollBarVisibility="Auto">
						<StackPanel Margin="0,0,15,0">
							<TextBlock Text="تجهيز الاستيكر"
									   FontSize="20"
									   FontWeight="Bold"
									   Margin="0,0,0,10" />
							<TextBlock Text="اختر المنتج" />
							<Grid>
								<TextBox x:Name="PrintProductSearch"
										 Height="39"
										 VerticalContentAlignment="Center"
										 TextChanged="PrintProductSearch_TextChanged"
										 PreviewKeyDown="PrintProductSearch_PreviewKeyDown"
										 GotKeyboardFocus="PrintProductSearch_GotKeyboardFocus"
										 ToolTip="اكتب اسم المنتج أو الكود، واستخدم الأسهم وEnter للاختيار" />
								<Popup x:Name="ProductSuggestionsPopup"
									   PlacementTarget="{Binding ElementName=PrintProductSearch}"
									   Placement="Bottom"
									   StaysOpen="False"
									   AllowsTransparency="True"
									   PopupAnimation="Fade">
									<Border Background="White"
											BorderBrush="#CBD5E1"
											BorderThickness="1"
											CornerRadius="6"
											MinWidth="345"
											MaxHeight="260"
											Padding="3"
											Effect="{x:Null}">
										<ListBox x:Name="ProductSuggestionsList"
												 MaxHeight="245"
												 PreviewKeyDown="ProductSuggestionsList_PreviewKeyDown"
												 PreviewMouseLeftButtonUp="ProductSuggestionsList_PreviewMouseLeftButtonUp"
												 MouseDoubleClick="ProductSuggestionsList_MouseDoubleClick">
											<ListBox.ItemTemplate>
												<DataTemplate>
													<StackPanel Margin="5,4">
														<TextBlock Text="{Binding Name}"
																   FontWeight="SemiBold" />
														<TextBlock Text="{Binding Code}"
																   FontSize="11"
																   Foreground="#64748B" />
													</StackPanel>
												</DataTemplate>
											</ListBox.ItemTemplate>
										</ListBox>
									</Border>
								</Popup>
							</Grid>
							<TextBlock Text="اسم الشركة على الاستيكر"
									   Margin="0,10,0,0" />
							<TextBox x:Name="PrintCompany"
									 TextChanged="Preview_Changed" />
							<TextBlock Text="رقم التليفون"
									   Margin="0,10,0,0" />
							<TextBox x:Name="PrintPhone"
									 TextChanged="Preview_Changed" />
							<TextBlock Text="تاريخ الإنتاج"
									   Margin="0,10,0,0" />
							<DatePicker x:Name="ProductionPicker"
										SelectedDateChanged="ProductionPicker_SelectedDateChanged" />
							<TextBlock Text="مدة الصلاحية بالأيام"
									   Margin="0,10,0,0" />
							<TextBox x:Name="PrintDays"
									 TextChanged="Preview_Changed" />
							<TextBlock Text="تاريخ الانتهاء (قابل للتعديل)"
									   Margin="0,10,0,0" />
							<DatePicker x:Name="ExpiryPicker"
										SelectedDateChanged="ExpiryPicker_SelectedDateChanged" />
							<CheckBox x:Name="AutoExpiryCheck"
									  Content="حساب الانتهاء تلقائيًا"
									  IsChecked="True"
									  Checked="AutoExpiryCheck_Changed"
									  Unchecked="AutoExpiryCheck_Changed"
									  Margin="4,5" />
							<CheckBox x:Name="ShowExpiryCheck"
									  Content="طباعة تاريخ الانتهاء على الاستيكر"
									  IsChecked="True"
									  Checked="VisualOptions_Changed"
									  Unchecked="VisualOptions_Changed"
									  Margin="4,9,4,3" />
							<TextBlock Text="حجم خط اسم المنتج"
									   Margin="0,8,0,0" />
							<StackPanel Orientation="Horizontal">
								<Slider x:Name="ProductFontSlider"
										Width="260"
										Minimum="8"
										Maximum="24"
										Value="13"
										TickFrequency="1"
										IsSnapToTickEnabled="True"
										ValueChanged="VisualOptions_Changed" />
								<TextBlock Text="{Binding ElementName=ProductFontSlider,Path=Value,StringFormat={}{0:0} pt}"
										   VerticalAlignment="Center"
										   Margin="8,0" />
							</StackPanel>
							<TextBlock Text="يمكن تعديل مدة الصلاحية يدويًا من الحقل أعلاه."
									   Foreground="#64748B"
									   FontSize="11" />
							<TextBlock Text="عدد النسخ"
									   Margin="0,10,0,0" />
							<TextBox x:Name="CopiesBox"
									 Text="1" />
							<TextBlock Text="عرض الاستيكر (ملليمتر)"
									   Margin="0,10,0,0" />
							<TextBox x:Name="WidthBox"
									 Text="60"
									 TextChanged="Preview_Changed" />
							<TextBlock Text="ارتفاع الاستيكر (ملليمتر)"
									   Margin="0,10,0,0" />
							<TextBox x:Name="HeightBox"
									 Text="40"
									 TextChanged="Preview_Changed" />
							<Button Content="تحديث المعاينة"
									Click="RefreshPreview_Click" />
							<Button x:Name="PrintButton"
									Content="اختيار الطابعة والطباعة"
									Background="#16A34A"
									Foreground="White"
									FontWeight="Bold"
									Click="Print_Click"
									Margin="3,10" />
							<TextBlock Text="اضبط مقاس الملصق نفسه في تعريف الطابعة أولًا. معاينة الشاشة تمثيلية للحجم والمحتوى."
									   Foreground="#64748B"
									   TextWrapping="Wrap"
									   FontSize="12"
									   Margin="4,8" />
						</StackPanel>
					</ScrollViewer>
					<Border Grid.Column="1"
							Background="#E2E8F0"
							CornerRadius="12"
							Padding="20">
						<StackPanel HorizontalAlignment="Center"
									VerticalAlignment="Center">
							<TextBlock Text="معاينة الملصق"
									   FontSize="20"
									   FontWeight="Bold"
									   HorizontalAlignment="Center"
									   Margin="0,0,0,15" />
							<Border Background="White"
									Padding="3"
									BorderBrush="#CBD5E1"
									BorderThickness="1">
								<Viewbox Width="590"
										 Height="390"
										 Stretch="Uniform">
									<ContentControl x:Name="LabelPreview" />
								</Viewbox>
							</Border>
							<TextBlock Text="سيظهر الباركود الحقيقي عند اختيار منتج"
									   Foreground="#475569"
									   HorizontalAlignment="Center"
									   Margin="0,12" />
						</StackPanel>
					</Border>
				</Grid>
			</TabItem>
			<TabItem Header="🕘 سجل الطباعة">
				<DockPanel Margin="15">
					<StackPanel DockPanel.Dock="Top"
								Orientation="Horizontal"
								Margin="0,0,0,10">
						<TextBlock Text="آخر عمليات الطباعة"
								   FontWeight="Bold"
								   FontSize="20" />
						<Button Content="تحديث السجل"
								Margin="15,0"
								Click="RefreshHistory_Click" />
						<Button Content="إعادة تجهيز العملية المحددة"
								Click="Reprint_Click" />
					</StackPanel>
					<DataGrid x:Name="HistoryGrid"
							  AutoGenerateColumns="False"
							  IsReadOnly="True"
							  SelectionMode="Single">
						<DataGrid.Columns>
							<DataGridTextColumn Header="رقم"
												Binding="{Binding Id}"
												Width="55" />
							<DataGridTextColumn Header="المنتج"
												Binding="{Binding ProductName}"
												Width="*" />
							<DataGridTextColumn Header="الكود"
												Binding="{Binding ProductCode}"
												Width="100" />
							<DataGridTextColumn Header="الإنتاج"
												Binding="{Binding ProductionDate, StringFormat=dd/MM/yyyy}"
												Width="105" />
							<DataGridTextColumn Header="الانتهاء"
												Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}"
												Width="105" />
							<DataGridTextColumn Header="نسخ"
												Binding="{Binding Quantity}"
												Width="55" />
							<DataGridTextColumn Header="الطابعة"
												Binding="{Binding PrinterName}"
												Width="160" />
							<DataGridTextColumn Header="الحالة"
												Binding="{Binding Status}"
												Width="100" />
							<DataGridTextColumn Header="التوقيت"
												Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
												Width="140" />
						</DataGrid.Columns>
					</DataGrid>
				</DockPanel>
			</TabItem>
			<TabItem Header="⚙ إعدادات الشركة">
				<StackPanel Width="460"
							HorizontalAlignment="Center"
							VerticalAlignment="Top"
							Margin="20">
					<TextBlock Text="الإعدادات الافتراضية للشركة"
							   FontSize="21"
							   FontWeight="Bold"
							   Margin="0,0,0,20" />
					<TextBlock Text="اسم الشركة" />
					<TextBox x:Name="CompanyBox" />
					<TextBlock Text="رقم الهاتف"
							   Margin="0,15,0,0" />
					<TextBox x:Name="PhoneBox" />
					<Button Content="حفظ إعدادات الشركة"
							Click="SaveSettings_Click"
							Background="#2563EB"
							Foreground="White"
							Margin="3,20" />
					<TextBlock Text="يمكنك تغيير الاسم والهاتف مؤقتًا في شاشة الطباعة دون تعديل الإعدادات الأساسية."
							   TextWrapping="Wrap"
							   Foreground="#64748B" />
				</StackPanel>
			</TabItem>
		</TabControl>
		<Border Grid.Row="2"
				Background="#E2E8F0">
			<Grid Margin="12,2">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="190" />
					<ColumnDefinition Width="54" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock x:Name="StatusText"
						   Text="جاهز"
						   VerticalAlignment="Center"
						   Foreground="#334155"
						   TextTrimming="CharacterEllipsis" />
				<ProgressBar x:Name="TaskProgress"
							 Grid.Column="1"
							 Minimum="0"
							 Maximum="100"
							 Height="15"
							 Value="0"
							 VerticalAlignment="Center"
							 Margin="8,0" />
				<TextBlock x:Name="ProgressPercentage"
						   Grid.Column="2"
						   Text="0%"
						   VerticalAlignment="Center"
						   TextAlignment="Center" />
				<TextBlock Grid.Column="3"
						   Text="إنتاج HT_SOLUTIONS  |  01157235269"
						   VerticalAlignment="Center"
						   FontWeight="SemiBold"
						   Foreground="#1E40AF"
						   Margin="12,0,0,0" />
			</Grid>
		</Border>
	</Grid>
</Window>
